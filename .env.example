LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_access_token
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
SHARED_DRIVE_ID=0A...shared_drive_id
ROOT_FOLDER_ID=1...folder_in_shared_drive_for_chats_and_mapping
MAX_FILE_MB=200
MAPPING_FILENAME=line-drive-mapping.json
# Push a Thai error notice to the chat when a save fails (true/false).
# Set false for a fully silent service (e.g. line-slip-saver); errors are still logged.
ERROR_REPLIES=true
# Upload a <stem>.json sidecar per saved file (line-slip-saver only)
SIDECAR_JSON=false
